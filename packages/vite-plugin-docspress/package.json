{
  "name": "vite-plugin-docspress",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "docspress": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./dist/sidebar.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./sidebar": {
      "types": "./src/sidebar/index.ts",
      "browser": "./dist/sidebar.js",
      "import": "./dist/sidebar.js"
    },
    "./client": {
      "types": "./src/runtime/client.ts",
      "import": "./dist/client.js"
    },
    "./entry-client": {
      "types": "./src/runtime/entry-client.tsx",
      "import": "./dist/entry-client.js"
    },
    "./entry-server": {
      "types": "./src/runtime/entry-server.tsx",
      "import": "./dist/entry-server.js"
    },
    "./react": {
      "types": "./src/runtime/react.tsx",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./dist/server.js"
    },
    "./virtual": {
      "types": "./src/virtual-modules.d.ts",
      "import": "./dist/virtual.js"
    }
  },
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "oxlint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "fast-glob": "^3.3.3",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "rolldown": "^1.0.0-rc.18",
    "typescript": "5.9.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
